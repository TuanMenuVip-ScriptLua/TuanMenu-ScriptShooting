--============================================================
-- HEAD VIEW - HÌNH TRÒN ĐỎ DÙNG DRAWING API
--============================================================

local HeadViewObjects = {}

local function ToggleHeadView(player, create)
    if player == LP then return end
    if create and not HeadViewObjects[player] then
        local circle = Drawing.new("Circle")
        circle.Thickness = 1
        circle.NumSides = 32
        circle.Radius = 20
        circle.Filled = true
        circle.Color = Color3.fromRGB(255, 0, 0)
        circle.Transparency = 0.3
        circle.Visible = false
        circle.ZIndex = 10
        
        HeadViewObjects[player] = {
            Circle = circle
        }
    elseif not create and HeadViewObjects[player] then
        if HeadViewObjects[player].Circle then
            HeadViewObjects[player].Circle:Remove()
        end
        HeadViewObjects[player] = nil
    end
end

local function updateHeadView(player)
    local data = HeadViewObjects[player]
    if not data then return end
    
    local char = player.Character
    if not char then
        if data.Circle then
            data.Circle.Visible = false
        end
        return
    end
    
    local head = char:FindFirstChild("Head")
    if not head then
        if data.Circle then
            data.Circle.Visible = false
        end
        return
    end
    
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    
    if not onScreen or pos.Z <= 0 then
        data.Circle.Visible = false
        return
    end
    
    local headSize = head.Size.Magnitude
    local scale = 1000 / pos.Z
    local radius = math.max(headSize * scale * 0.5, 15)
    radius = math.min(radius, 150)
    
    data.Circle.Position = Vector2.new(pos.X, pos.Y)
    data.Circle.Radius = radius
    data.Circle.Visible = true
end

local function clearAllHeadViews()
    for player, data in pairs(HeadViewObjects) do
        if data.Circle then
            data.Circle:Remove()
        end
    end
    HeadViewObjects = {}
end

