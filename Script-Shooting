local function MakeSliderUI(txtDef, minV, maxV, initV, order, callback)
    local frame = Instance.new("Frame", Container)
    frame.Size = UDim2.new(0.9, 0, 0, 24)
    frame.BackgroundTransparency = 1
    frame.LayoutOrder = order
    frame.Parent = Container

    local txt = Instance.new("TextLabel", frame)
    txt.Size = UDim2.new(1, 0, 0, 12)
    txt.Text = txtDef..initV
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.fromRGB(150, 255, 150)
    txt.Font = Enum.Font.Code
    txt.TextSize = 11
    txt.Parent = frame

    local back = Instance.new("Frame", frame)
    back.Size = UDim2.new(1, 0, 0, 5)
    back.Position = UDim2.new(0, 0, 0, 15)
    back.BackgroundColor3 = Color3.fromRGB(40, 60, 40)
    back.Parent = frame
    Corner(back, 3)

    local bar = Instance.new("Frame", back)
    bar.Size = UDim2.new((initV-minV)/(maxV-minV), 0, 1, 0)
    bar.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
    bar.Parent = back
    Corner(bar, 3)

    local function update(inputX)
        local pct = math.clamp((inputX - back.AbsolutePosition.X) / back.AbsoluteSize.X, 0, 1)
        local val = minV + (maxV - minV) * pct
        if maxV <= 1 then
            val = math.floor(val * 100) / 100
        else
            val = math.floor(val)
        end
        bar.Size = UDim2.new(pct, 0, 1, 0)
        txt.Text = txtDef..val
        callback(val)
    end

    back.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = update
            update(input.Position.X)
        end
    end)
end

