local ContentFrame = Instance.new("Frame")
ContentFrame.Parent = MainFrame
ContentFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
ContentFrame.BorderSizePixel = 0
ContentFrame.Position = UDim2.new(0, 0, 0, 80)
ContentFrame.Size = UDim2.new(1, 0, 1, -80)

local function createContent(tabName)
    local content = Instance.new("Frame")
    content.Parent = ContentFrame
    content.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    content.BorderSizePixel = 0
    content.Size = UDim2.new(1, 0, 1, 0)
    content.Visible = false
    content.Name = tabName .. "Content"
    
    if tabName == "AIMBOT" then
        local toggles = {"Enable Aimbot", "Silent Aim", "Triggerbot", "Auto Shoot"}
        local y = 20
        for _, toggle in ipairs(toggles) do
            local check = Instance.new("TextButton")
            check.Parent = content
            check.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            check.BorderSizePixel = 0
            check.Position = UDim2.new(0.1, 0, 0, y)
            check.Size = UDim2.new(0.8, 0, 0, 30)
            check.Font = Enum.Font.Gotham
            check.Text = "☐ " .. toggle
            check.TextColor3 = Color3.fromRGB(180, 180, 200)
            check.TextSize = 14
            y = y + 40
        end
    elseif tabName == "ESP" then
        local toggles = {"Box ESP", "Name ESP", "Health Bar", "Distance", "Skeleton ESP"}
        local y = 20
        for _, toggle in ipairs(toggles) do
            local check = Instance.new("TextButton")
            check.Parent = content
            check.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            check.BorderSizePixel = 0
            check.Position = UDim2.new(0.1, 0, 0, y)
            check.Size = UDim2.new(0.8, 0, 0, 30)
            check.Font = Enum.Font.Gotham
            check.Text = "☐ " .. toggle
            check.TextColor3 = Color3.fromRGB(180, 180, 200)
            check.TextSize = 14
            y = y + 40
        end
    end
    return content
end

local aimbotContent = createContent("AIMBOT")
local espContent = createContent("ESP")
local miscContent = createContent("MISC")
local settingsContent = createContent("SETTINGS")

aimbotContent.Visible = true

for tabName, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        for _, child in pairs(ContentFrame:GetChildren()) do
            if child:IsA("Frame") then
                child.Visible = false
            end
        end
        local content = ContentFrame:FindFirstChild(tabName .. "Content")
        if content then
            content.Visible = true
        end
    end)
end

local function setupToggles()
    for _, frame in pairs(ContentFrame:GetChildren()) do
        if frame:IsA("Frame") then
            for _, btn in pairs(frame:GetChildren()) do
                if btn:IsA("TextButton") and btn.Text:match("☐") then
                    btn.MouseButton1Click:Connect(function()
                        if btn.Text:match("☐") then
                            btn.Text = btn.Text:gsub("☐", "☑")
                            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
                        else
                            btn.Text = btn.Text:gsub("☑", "☐")
                            btn.TextColor3 = Color3.fromRGB(180, 180, 200)
                        end
                    end)
                end
            end
        end
    end
end
setupToggles()

CloseButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
end)

game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.Insert then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

